# Public site URL — used for canonical links, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://www.triovainfradesigns.com

# ---------------------------------------------------------------------------
# Contact form delivery. Nothing is sent until one of these is configured and
# the corresponding block in src/app/api/contact/route.ts is uncommented.
# ---------------------------------------------------------------------------

# Option A — Resend
RESEND_API_KEY=
CONTACT_FROM_EMAIL=enquiries@triovainfradesigns.com
CONTACT_TO_EMAIL=triova.infradesigns@gmail.com

# Option B — SMTP / Nodemailer
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
